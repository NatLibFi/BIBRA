[defaults]
# Default settings for all projects (each project can override)
api_key = "${LLM_API_KEY}"
endpoint = "${LLM_ENDPOINT_URL}"

[greylitlm]
name = "GreyLitLM project"
backend = "greylitlm"
model = "${GREYLITLM_MODEL}"

[nuextract]
name = "NuExtract project"
backend = "nuextract"
model = "${NUEXTRACT_MODEL}"
thinking = true
dpi = 200

[dummy]
name = "Dummy project"
backend = "dummy"
