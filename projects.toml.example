[defaults]
# Default settings for all projects (each project can override)
api_key = "${LLM_API_KEY}"
endpoint = "${LLM_ENDPOINT_URL}"
#extra_headers = { MyHeader = "${MY_ENV}" }
# Pages to extract (1-based; negative counts from the last page).
# Default: first six + last two pages. At most 8 pages are accepted.
#pages = [1, 2, 3, 4, -2, -1]

[greylitlm]
name = "GreyLitLM project"
backend = "greylitlm"
model = "${GREYLITLM_MODEL}"

[nuextract]
name = "NuExtract project"
backend = "nuextract"
model = "${NUEXTRACT_MODEL}"
thinking = true
dpi = 200
# Extract only the first four and the last two pages (max 8 pages)
#pages = [1, 2, 3, 4, -2, -1]

[dummy]
name = "Dummy project"
backend = "dummy"
